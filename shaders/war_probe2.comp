#version 450

/* Parametric WAR/RAW probe. Tests several hypotheses about why batching helps:
 *
 *   N_PAIRS — how many (iadd → lload) dependency pairs per inner iter.
 *     If model is "0.84 cycle/pair", time should scale linearly in N_PAIRS.
 *
 *   N_PADDING — number of independent ops inserted between each iadd and
 *     its dependent lload. Should reduce the RAW stall (gives the iadd
 *     time to complete before the lload tries to read it).
 *
 *   BATCHED — 0 = interleaved (iadd, lload, iadd, lload, ...);
 *             1 = batched (all iadds, then all lloads). */

layout(local_size_x = 128) in;

layout(constant_id = 0) const uint OUTER_ITERS = 32768u;
layout(constant_id = 1) const uint N_PAIRS = 8u;        // 1..16
layout(constant_id = 2) const uint N_PADDING = 0u;      // 0..8 independent ops between iadd and lload
layout(constant_id = 3) const uint BATCHED = 0u;        // 0 or 1

shared uint scratch[512];

layout(std430, binding = 0) buffer Out { uint data[]; };

#define DO_PAIR(IDX) {                                                       \
    uint addr_##IDX = tid + (IDX);                                          \
    /* N_PADDING independent ops between iadd computation and the lload */  \
    pad ^= pad + (IDX) * 7u;                                                \
    if (N_PADDING > 0u) pad ^= pad + (IDX) * 11u;                           \
    if (N_PADDING > 1u) pad ^= pad + (IDX) * 13u;                           \
    if (N_PADDING > 2u) pad ^= pad + (IDX) * 17u;                           \
    if (N_PADDING > 3u) pad ^= pad + (IDX) * 19u;                           \
    val_##IDX = scratch[addr_##IDX];                                        \
}

#define DO_IADD(IDX) {                                                       \
    addr_##IDX = tid + (IDX);                                                \
    pad ^= pad + (IDX) * 7u;                                                 \
}
#define DO_LLOAD(IDX) { val_##IDX = scratch[addr_##IDX]; }

void main() {
    uint tid = gl_LocalInvocationID.x;

    /* Pre-populate shmem. */
    for (uint i = 0u; i < 4u; i++) {
        scratch[tid + i * 128u] = data[tid + i * 128u] + tid;
    }
    barrier();

    uint acc = 0u;
    uint pad = tid;

    /* Up to 16 supported pairs. Variables must be declared statically. */
    uint addr_0, addr_1, addr_2, addr_3, addr_4, addr_5, addr_6, addr_7;
    uint val_0, val_1, val_2, val_3, val_4, val_5, val_6, val_7;

    for (uint iter = 0u; iter < OUTER_ITERS; iter++) {
        if (BATCHED == 1u) {
            /* All iadds first, then all lloads. */
            if (N_PAIRS > 0u) DO_IADD(0)
            if (N_PAIRS > 1u) DO_IADD(1)
            if (N_PAIRS > 2u) DO_IADD(2)
            if (N_PAIRS > 3u) DO_IADD(3)
            if (N_PAIRS > 4u) DO_IADD(4)
            if (N_PAIRS > 5u) DO_IADD(5)
            if (N_PAIRS > 6u) DO_IADD(6)
            if (N_PAIRS > 7u) DO_IADD(7)
            if (N_PAIRS > 0u) DO_LLOAD(0)
            if (N_PAIRS > 1u) DO_LLOAD(1)
            if (N_PAIRS > 2u) DO_LLOAD(2)
            if (N_PAIRS > 3u) DO_LLOAD(3)
            if (N_PAIRS > 4u) DO_LLOAD(4)
            if (N_PAIRS > 5u) DO_LLOAD(5)
            if (N_PAIRS > 6u) DO_LLOAD(6)
            if (N_PAIRS > 7u) DO_LLOAD(7)
        } else {
            /* Interleaved: iadd, lload, iadd, lload, ... */
            if (N_PAIRS > 0u) DO_PAIR(0)
            if (N_PAIRS > 1u) DO_PAIR(1)
            if (N_PAIRS > 2u) DO_PAIR(2)
            if (N_PAIRS > 3u) DO_PAIR(3)
            if (N_PAIRS > 4u) DO_PAIR(4)
            if (N_PAIRS > 5u) DO_PAIR(5)
            if (N_PAIRS > 6u) DO_PAIR(6)
            if (N_PAIRS > 7u) DO_PAIR(7)
        }

        if (N_PAIRS > 0u) acc ^= val_0;
        if (N_PAIRS > 1u) acc ^= val_1;
        if (N_PAIRS > 2u) acc ^= val_2;
        if (N_PAIRS > 3u) acc ^= val_3;
        if (N_PAIRS > 4u) acc ^= val_4;
        if (N_PAIRS > 5u) acc ^= val_5;
        if (N_PAIRS > 6u) acc ^= val_6;
        if (N_PAIRS > 7u) acc ^= val_7;
    }

    data[tid] = acc ^ pad;
}
