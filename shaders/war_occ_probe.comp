#version 450

/* Tests how occupancy affects the iadd→lload RAW stall.
 * Pads shared memory to force different occupancy levels. */

layout(local_size_x = 128) in;

layout(constant_id = 0) const uint OUTER_ITERS = 32768u;
layout(constant_id = 1) const uint SHMEM_WORDS = 256u;

shared uint scratch[16384]; /* up to 64 KB, actual usage varies via SHMEM_WORDS */

layout(std430, binding = 0) buffer Out { uint data[]; };

void main() {
    uint tid = gl_LocalInvocationID.x;

    /* Initialize the shmem region. */
    for (uint i = tid; i < SHMEM_WORDS; i += 128u) {
        scratch[i] = data[i] + tid;
    }
    barrier();

    uint acc0 = 0u, acc1 = 0u, acc2 = 0u, acc3 = 0u;
    uint acc4 = 0u, acc5 = 0u, acc6 = 0u, acc7 = 0u;

    for (uint iter = 0u; iter < OUTER_ITERS; iter++) {
        /* 8 iadd→lload pairs. Distinct address writes via tid + offset.
         * The Mesa batching pass (env-gated) will either cluster these
         * (all iadds first, then all lloads) or leave them interleaved. */
        uint b0 = tid + 0u;
        acc0 ^= scratch[b0 % SHMEM_WORDS];
        uint b1 = tid + 1u;
        acc1 ^= scratch[b1 % SHMEM_WORDS];
        uint b2 = tid + 2u;
        acc2 ^= scratch[b2 % SHMEM_WORDS];
        uint b3 = tid + 3u;
        acc3 ^= scratch[b3 % SHMEM_WORDS];
        uint b4 = tid + 4u;
        acc4 ^= scratch[b4 % SHMEM_WORDS];
        uint b5 = tid + 5u;
        acc5 ^= scratch[b5 % SHMEM_WORDS];
        uint b6 = tid + 6u;
        acc6 ^= scratch[b6 % SHMEM_WORDS];
        uint b7 = tid + 7u;
        acc7 ^= scratch[b7 % SHMEM_WORDS];
    }

    data[tid] = acc0 ^ acc1 ^ acc2 ^ acc3 ^ acc4 ^ acc5 ^ acc6 ^ acc7;
    /* Force the shmem allocation to remain in use after compile. */
    if (tid == 0xdeadbeef) data[0] = scratch[SHMEM_WORDS - 1u];
}
